{
  "id": "policy.draft-clinical-use-boundary",
  "version": "0.1.0",
  "lifecycle_status": "draft",
  "review_status": "unreviewed",
  "clinical_use_status": "limited",
  "legacy_compatibility": {
    "legacy_status": "research_only",
    "interpretation": "A historical schema and transport label retained until a versioned migration; it is not the lifecycle status of current clinical content."
  },
  "allowed_use_modes": [
    "research_test",
    "simulation",
    "clinician_supervised_pilot"
  ],
  "clinical_decision_boundary": {
    "purpose": "previsit_information_collection_and_informational_support",
    "independent_diagnosis_authority": false,
    "independent_treatment_authority": false,
    "prescribing_authority": false,
    "may_provide_general_information": true,
    "must_express_uncertainty": true,
    "must_distinguish_information_from_diagnosis_or_prescription": true,
    "must_handoff_consequential_decisions_to_a_clinician": true
  },
  "safety_boundary": {
    "authority": "protective_notification_and_handoff_only",
    "sensitivity_first": true,
    "notify_when_red_flag_is_suspected": true,
    "false_positive_tolerance": "accepted_for_protective_routing",
    "interview_completion_must_not_delay_notification": true,
    "must_not_claim_a_diagnosis_from_a_safety_rule": true,
    "must_report_triggering_facts_and_uncertainty": true
  },
  "restricted_uses": [
    "autonomous_diagnosis",
    "autonomous_treatment_selection",
    "medication_start_stop_or_dose_instruction",
    "unsupervised_safety_critical_clinical_decision"
  ],
  "required_disclosure": "검토 전 초안 지식에 기반한 제한적 정보 제공이며, 독립적인 진단·치료 결정을 대신하지 않습니다.",
  "contains_patient_responses": false
}
