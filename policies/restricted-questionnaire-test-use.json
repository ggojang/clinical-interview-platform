{
  "id": "policy.restricted-questionnaire-test-use",
  "version": "0.1.0",
  "status": "draft",
  "review_status": "unreviewed",
  "purpose": "Permit controlled internal testing of user-supplied or licensed source-defined FHIR Questionnaires without redistributing their item text.",
  "required": {
    "test_only": true,
    "local_restricted_store": "private-data/questionnaires",
    "exact_source_and_version": true,
    "sha256_verified": true,
    "rights_status_verified": true,
    "questionnaire_response_persistence": false,
    "public_gpt_export": false,
    "repository_commit_of_item_text": false,
    "item_rewriting": false,
    "automatic_standard_mapping": false,
    "scoring_without_separate_specification_and_rights": false
  },
  "allowed_rights_status": [
    "user_supplied_for_internal_test",
    "written_permission_for_internal_test",
    "artifact_license_allows_internal_test"
  ],
  "provenance": {
    "created_by": {
      "type": "ai",
      "id": "codex-gpt5"
    },
    "created_at": "2026-08-13T20:00:00+09:00",
    "contains_patient_responses": false,
    "contains_source_defined_item_text": false
  }
}
