    {
      "id": "rule.alcohol-use-counselling.safety.withdrawal-warning",
      "priority": 1195,
      "when": {
        "all": [
          {
            "fact": "alcohol.recent_reduction_or_stop",
            "equals": true
          },
          {
            "fact": "alcohol.current_withdrawal_warning",
            "in": [
              "tremor",
              "sweating",
              "vomiting",
              "marked_anxiety_or_agitation",
              "hallucination",
              "confusion",
              "seizure"
            ]
          }
        ]
      },
      "then": {
        "safety_level": "urgent",
        "action": "human_handoff",
        "suppress_routine": true
      }
    }
