{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Computable Knowledge Standards Reference Registry",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "review_status",
    "contains_patient_responses",
    "frameworks",
    "rule_projection_profiles",
    "provenance"
  ],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"const": "research_only"},
    "review_status": {"const": "unreviewed"},
    "contains_patient_responses": {"const": false},
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "jurisdiction",
          "role",
          "adoption",
          "source_ids",
          "permitted_uses",
          "prohibited_uses"
        ],
        "properties": {
          "id": {"type": "string"},
          "jurisdiction": {"type": "string"},
          "role": {"type": "string"},
          "adoption": {
            "enum": [
              "active_reference",
              "reference_only",
              "secondary_research",
              "external_adapter_only"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "permitted_uses": {
            "type": "array",
            "items": {"type": "string"}
          },
          "prohibited_uses": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    },
    "rule_projection_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_type",
          "cql_role",
          "fhir_clinical_reasoning_role",
          "gdl2_role",
          "emission_status"
        ],
        "properties": {
          "rule_type": {
            "enum": [
              "activation",
              "applicability",
              "requirement",
              "completion",
              "priority",
              "suppression",
              "conflict",
              "safety",
              "transition",
              "stop",
              "mapping"
            ]
          },
          "emission_status": {"const": "metadata_only_not_emitted"}
        },
        "additionalProperties": true
      }
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
