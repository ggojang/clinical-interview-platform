[Unit]
Description=Clinical Interview API staging service
After=network-online.target

[Container]
ContainerName=ciai-api
Image=localhost/ciai-api:staging
PublishPort=10.20.0.12:9090:8000

Environment=TZ=Asia/Seoul
Environment=CLINICAL_API_HOST=0.0.0.0
Environment=CLINICAL_API_PORT=8000
Environment=CLINICAL_API_SESSION_TTL=1800
Environment=CLINICAL_API_MAX_SESSIONS=250
Environment=CLINICAL_API_EXECUTION_MODE=research_test
Secret=ciai-api-key,type=env,target=CLINICAL_API_KEY

ReadOnly=true
ReadOnlyTmpfs=true
DropCapability=all
NoNewPrivileges=true

HealthCmd=["CMD","python","-c","import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3).read()"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s

LogDriver=json-file
LogOpt=max-size=10m
LogOpt=max-file=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
