{
  "id": "simulation.computable-knowledge-standards-cases",
  "version": "0.1.0",
  "status": "synthetic",
  "contains_real_patient_data": false,
  "cases": [
    {
      "id": "CKS-AU-NO-CLINICAL-AUTHORITY",
      "condition": "An AUCDI or AU Core element is missing from a Korean interview package.",
      "expected": ["gap_reported", "no_automatic_question", "deployment_jurisdiction_KR", "kr_core_precedence_preserved"]
    },
    {
      "id": "CKS-AU-SMART-FORMS-CI",
      "condition": "A Smart Forms CI example contains prepopulation, enableWhen and extraction patterns.",
      "expected": ["pattern_reference_only", "no_fixed_questionnaire_import", "no_ci_conformance_claim"]
    },
    {
      "id": "CKS-OPENEHR-REQUIRED-NODE",
      "condition": "An openEHR template marks a node required but the value is clinician-observed or record-prepopulated.",
      "expected": ["source_role_classified", "no_automatic_patient_question", "missing_data_not_fabricated"]
    },
    {
      "id": "CKS-OPENEHR-LOCAL-CODE",
      "condition": "An archetype node has an at-code without a verified external terminology mapping.",
      "expected": ["at_code_retained_as_local", "no_false_loinc_or_snomed_mapping"]
    },
    {
      "id": "CKS-CQL-SEMANTIC-DIFF",
      "condition": "A future CQL expression differs from the internal Rule Graph for an unknown or dataAbsentReason state.",
      "expected": ["projection_rejected", "rule_graph_remains_authoritative", "dataAbsentReason_preserved"]
    },
    {
      "id": "CKS-PLAN-DEFINITION-ACTION",
      "condition": "A PlanDefinition action describes a possible clinical activity.",
      "expected": ["definition_not_order", "definition_not_performance_record", "interview_package_cannot_order"]
    },
    {
      "id": "CKS-GDL2-TRIAL",
      "condition": "A GDL2 projection is syntactically plausible but no conformant engine test has run.",
      "expected": ["secondary_research_only", "no_runtime_activation", "no_conformance_claim"]
    },
    {
      "id": "CKS-CDS-HOOKS-UNAVAILABLE",
      "condition": "An external CDS Hooks service is unavailable during an interview.",
      "expected": ["runtime_continues_with_compiled_package", "safety_unchanged", "external_adapter_failure_reported"]
    },
    {
      "id": "CKS-FIXED-QUESTIONNAIRE",
      "condition": "A source-defined patient-experience questionnaire resembles an AU or openEHR data structure.",
      "expected": ["fixed_questionnaire_excluded", "official_wording_preserved", "no_automatic_mapping"]
    },
    {
      "id": "CKS-LICENSE-UNKNOWN",
      "condition": "A CKM artifact has useful structure but its artifact license or embedded terminology license is not verified.",
      "expected": ["metadata_reference_only", "content_not_imported", "license_gap_reported"]
    }
  ],
