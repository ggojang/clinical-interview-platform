CLINICAL_API_HOST=127.0.0.1
CLINICAL_API_PORT=8000
CLINICAL_API_KEY=replace-with-a-long-random-value
CLINICAL_API_ALLOWED_ORIGINS=https://example.org
CLINICAL_API_SESSION_TTL=1800
CLINICAL_API_MAX_SESSIONS=1000
CLINICAL_API_EXECUTION_MODE=research_test
# Optional public demo surface. Keep the authenticated /v1 API protected.
CLINICAL_API_ANONYMOUS_DEMO_ENABLED=false
CLINICAL_API_ANONYMOUS_DEMO_TTL=600
CLINICAL_API_ANONYMOUS_DEMO_MAX_SESSIONS=50
CLINICAL_API_ANONYMOUS_DEMO_REQUESTS_PER_MINUTE=240
CLINICAL_LLM_LOCAL_ENABLED=true
CLINICAL_LLM_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
CLINICAL_LLM_LOCAL_MODEL=qwen3-27b
# Optional; inject as a secret when the local endpoint requires authentication.
# CLINICAL_LLM_LOCAL_API_KEY=do-not-store-real-values-here
CLINICAL_LLM_DEFAULT_PROVIDER=local_vllm
CLINICAL_LLM_CHATBOT_KNOWLEDGE_DELIVERY=compiled_candidate_window
CLINICAL_LLM_CHATBOT_INSTRUCTION_PROFILE=compiled_clinical_adaptive
CLINICAL_LLM_CHATBOT_GENERATION_SLOT=2
CLINICAL_LLM_CHATBOT_RETRIEVAL_SLOT=3
CLINICAL_LLM_PRESENTATION_ENABLED=false
CLINICAL_LLM_TIMEOUT_SECONDS=12
CLINICAL_LLM_HEALTH_INFORMATION_TIMEOUT_SECONDS=30
# Optional commercial providers are server-side allowlisted. Never put a real
# key in this JSON or in a request; api_key_env names a separately injected
# secret environment variable.
CLINICAL_LLM_PROVIDERS_JSON=[]
